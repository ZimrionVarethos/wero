# Copy to .env.local for local development. Never commit real values.

# Supabase project (public values, used by the browser client for admin login)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Server-side Postgres connection used by the API routes (use Transaction Mode pooler on port 6543 for serverless/Vercel)
DATABASE_URL=postgresql://postgres.your-project:your-password@aws-0-region.pooler.supabase.com:6543/postgres

# Optional bootstrap. Comma separated emails treated as SUPER_ADMIN until roles are
# granted in public.user_roles (see supabase/admin_roles_setup.sql). Leave empty in production.
ADMIN_EMAILS=

# Download link for the landing page APK button
NEXT_PUBLIC_APK_URL=/wero.apk

# Push notifications for broadcasts (see src/lib/fcm.ts)
FIREBASE_SERVICE_ACCOUNT=
FCM_SERVER_KEY=

# Alternative to FIREBASE_SERVICE_ACCOUNT, as separate fields
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Disaster knowledge assistant (src/app/api/assistant/chat)
GEMINI_API_KEY=
GEMINI_MODEL=

# Reverse geocoding for the mobile app (src/app/api/geocode)
NEXT_PUBLIC_MAPBOX_TOKEN=
